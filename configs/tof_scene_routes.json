{
  "version": "tof_formal_v1_20261017",
  "sensors": ["tof"],
  "manual_scene_selection": true,
  "scenes": {
    "ordinary_diffuse": {"initialization": "empty_geometry", "input": "aligned_metric_depth", "vision": false},
    "partial_depth_loss": {"initialization": "empty_geometry", "input": "aligned_metric_depth", "loss_scope_pct": [0, 50], "vision": false},
    "low_light": {"initialization": "empty_geometry", "input": "aligned_metric_depth", "vision": false},
    "glare": {"initialization": "empty_geometry", "input": "aligned_metric_depth", "vision": false},
    "uneven_surface": {"initialization": "empty_geometry", "input": "aligned_metric_depth", "vision": false, "additional_output": "highest_height_m"},
    "floating_objects": {"initialization": "empty_geometry", "input": "aligned_metric_depth_optional_rgb", "vision": "optional_highest_only", "additional_output": "highest_height_m"},
    "homogeneous_transparent": {"initialization": "five_phase_priors", "input": "three_frequency_four_phase_correlations", "vision": false},
